# Sin variables la app funciona en modo local: motor mock, sin login y sin persistencia.

# Supabase: dashboard → Connect → App Frameworks → Next.js
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Motor de recomendación ─────────────────────────────────────────────
# Con OPENROUTER_API_KEY se usa OpenRouter; si no, DeepSeek con DEEPSEEK_API_KEY; si no, el mock.
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=

# Opcionales:
# LLM_PROVIDER=openrouter        # openrouter | deepseek (fuerza uno si tenés las dos claves)
# LLM_MODELS=moonshotai/kimi-k2.6 # separados por coma: el primero es el preferido, el resto respaldos (OpenRouter)
# LLM_REASONING=none             # none | low | high | max: mejores mapas, bastante más lento
# LLM_JSON_SCHEMA=1              # OpenRouter: salida con JSON Schema (solo proveedores que lo soportan)
# LLM_COMPARE_MODELS=moonshotai/kimi-k2.6,otro/modelo   # para pnpm engine:compare
# LINEAS_ENGINE=mock             # fuerza el mock aunque haya claves (trabajar en la UI sin gastar)

# Catálogo: Google Books funciona sin clave, pero con cuota baja compartida.
# GOOGLE_BOOKS_API_KEY=
