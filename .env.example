# Sin variables la app funciona en modo local: motor mock, sin login y sin persistencia.

# Supabase: dashboard → Connect → App Frameworks → Next.js
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Motor de recomendación. Con DEEPSEEK_API_KEY se usa DeepSeek; sin ella, el mock.
DEEPSEEK_API_KEY=
# Opcionales:
# LINEAS_ENGINE=mock            # fuerza el mock aunque haya clave (para trabajar en la UI sin gastar)
# DEEPSEEK_MODEL=deepseek-flash # o deepseek-v4-pro
# DEEPSEEK_REASONING=none       # none | low | high | max (más lento y caro, quizá mejores conexiones)

# Catálogo: Google Books funciona sin clave, pero con cuota baja compartida.
# GOOGLE_BOOKS_API_KEY=
