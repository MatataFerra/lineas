# Hoy la app funciona sin variables (motor mock).
# Se van a necesitar en los próximos pasos:

# Motor de recomendación: "mock" | "llm"
# LINEAS_ENGINE=mock

# Proveedor del modelo (uno de los dos)
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=

# Catálogo de libros (opcional: Google Books funciona sin clave con cuota baja)
# GOOGLE_BOOKS_API_KEY=

# Supabase
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
